NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000/admin
# Filled by `npm run convex:dev`; use separate deployments for dev and production.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
CONVEX_SITE_URL=
# Generate a 32+ character secret. Set the SAME value in the Convex deployment.
# Also signs short-lived confirmation receipts; rotating it expires existing receipts.
CONVEX_SERVER_SECRET=
# Disabled by default. Use "development" for dev-server-only submissions.
# Production requires "true" plus finalized privacy policy.
SUBMISSIONS_ENABLED=false
PRIVACY_POLICY_APPROVED=false
PRIVACY_CONTACT_EMAIL=
PRIVACY_ORGANIZATION=
PRIVACY_RETENTION_NOTICE=
# Configure Clerk for email/password, recovery, and restricted sign-up.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Backend-only: copy the matching Clerk key to Convex for owner invitations.
# Development configure script derives this URL from NEXT_PUBLIC_ADMIN_URL.
# Convex production: https://admin.taskwaveph.com/sign-up
STAFF_INVITATION_REDIRECT_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/admin/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/admin/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/admin
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/admin
# Also set in the Convex deployment and enable the Clerk Convex integration.
CLERK_JWT_ISSUER_DOMAIN=
# Production requires real keys, never Cloudflare test keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional isolated Next.js build directory for local integration tests.
NEXT_BUILD_DIR=.next

# Backend-only flag; seed scripts enable it temporarily on development and reset it.
# Never enable on production. No frontend code reads this value.
ALLOW_DEVELOPMENT_SEED=false

# Optional: disable build compiler disk cache on constrained local workspaces.
NEXT_BUILD_CACHE=true
NEXT_DEV_CACHE=true

# Optional: port of an already-running isolated localhost preview test server.
# Used only by npm run test:preview; does not change website deployment URLs.
PLAYWRIGHT_PREVIEW_PORT=3000

# Application notifications: set these in CONVEX, not NEXT_PUBLIC_* variables.
# Disabled until a verified sender and key are configured. No historical emails.
APPLICATION_NOTIFICATIONS_ENABLED=false
APPLICATION_NOTIFICATION_TO=franzhbataan@gmail.com
APPLICATION_NOTIFICATION_FROM=TaskWavePH Recruitment <notifications@notify.taskwaveph.com>
APPLICATION_NOTIFICATION_ADMIN_URL=https://admin.taskwaveph.com
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Test mode accepts only delivered@resend.dev (or delivered+label@resend.dev).
# For a deliberate development email, change TO to a test address and use a development sending key.
# Real recipients require explicit RESEND_TEST_MODE=false.
RESEND_TEST_MODE=true
