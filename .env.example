NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000/admin
# Filled by `npm run convex:dev`; use separate deployments for dev and production.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
CONVEX_SITE_URL=
# Generate a 32+ character secret. Set the SAME value in the Convex deployment.
CONVEX_SERVER_SECRET=
# Disabled by default. Production additionally requires finalized privacy policy.
SUBMISSIONS_ENABLED=false
PRIVACY_POLICY_APPROVED=false
PRIVACY_CONTACT_EMAIL=
PRIVACY_ORGANIZATION=
PRIVACY_RETENTION_NOTICE=
# Configure Clerk for email/password, recovery, and restricted sign-up.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Also set in the Convex deployment and enable the Clerk Convex integration.
CLERK_JWT_ISSUER_DOMAIN=
# Production requires real keys, never Cloudflare test keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional isolated Next.js build directory for local integration tests.
NEXT_BUILD_DIR=.next
